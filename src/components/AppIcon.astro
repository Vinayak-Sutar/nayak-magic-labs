---
/** A small pictogram per app, drawn on a 24-unit grid with square caps. */
import type { App } from '../lib/content';

interface Props {
  name: App['data']['icon'];
  size?: number;
}

const { name, size = 44 } = Astro.props;
---

<span class="app-icon" style={`--size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square">
    {
      name === 'valocut' && (
        <Fragment>
          <circle cx="12" cy="12" r="6.25" />
          <path d="M12 2.75v4M12 17.25v4M2.75 12h4M17.25 12h4" />
          <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
        </Fragment>
      )
    }
    {
      name === 'nuqta' && (
        <Fragment>
          <rect x="9" y="3.6" width="6" height="6" transform="rotate(45 12 6.6)" fill="currentColor" stroke="none" />
          <path d="M4 14.5c2.4 5.4 13.6 5.4 16 0" />
        </Fragment>
      )
    }
    {
      name === 'leetviz' && (
        <Fragment>
          <path d="M5 20v-6M10 20V9M15 20v-8M20 20V5" stroke-width="2.5" />
          <circle cx="10" cy="4.6" r="1.4" fill="currentColor" stroke="none" />
        </Fragment>
      )
    }
    {
      name === 'chords' && (
        <Fragment>
          <path d="M5.5 4.5h13" stroke-width="2.5" />
          <path d="M5.5 5v15M9.83 5v15M14.17 5v15M18.5 5v15M5.5 10h13M5.5 15h13" stroke-width="1.25" />
          <circle cx="9.83" cy="7.6" r="1.7" fill="currentColor" stroke="none" />
          <circle cx="14.17" cy="12.5" r="1.7" fill="currentColor" stroke="none" />
        </Fragment>
      )
    }
    {
      name === 'nakama' && (
        <Fragment>
          <rect x="3" y="4.5" width="18" height="15" rx="2" />
          <path d="M6.75 12h3.5M12.75 12h4.5M6.75 15.5h6.5M15.75 15.5h1.5" />
        </Fragment>
      )
    }
    {
      name === 'remote' && (
        <Fragment>
          <rect x="4.5" y="2.75" width="10" height="18.5" rx="2" />
          <path d="M8.5 18h2" />
          <path d="M13.5 8.5l7 2.8-3 1.2-1.2 3z" fill="currentColor" stroke-linejoin="round" stroke-width="1" />
        </Fragment>
      )
    }
  </svg>
</span>

<style>
  .app-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border-radius: 24%;
    background: var(--panel);
    color: var(--ink);
    transition:
      background-color 0.25s,
      color 0.25s;
  }
  .app-icon svg {
    width: 56%;
    height: 56%;
  }
  :global(.band) .app-icon {
    background: var(--band-raise);
    color: var(--paper);
  }
</style>

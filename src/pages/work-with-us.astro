---
import EnquiryForm from '../components/EnquiryForm.astro';
import { COMMISSIONS, HIRE_FAQ, PROOF, STEPS } from '../data/studio';
import BaseLayout from '../layouts/BaseLayout.astro';
import { appUrl } from '../lib/content';
import { breadcrumbs, faqPage } from '../lib/schema';
---

<BaseLayout
  title="Work with us"
  description="Hire Nayak Magic Labs to build a Chrome extension, Windows app, web app, AI feature or website. The same process as our own apps, from first prototype to a published release."
  footerCta={false}
  jsonLd={[
    faqPage(HIRE_FAQ),
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Work with us', path: '/work-with-us/' },
    ]),
  ]}
>
  <section class="wrap head">
    <h1 class="display h-page">Work with us</h1>
    <p class="lede">
      We take on a small number of client projects each year, and are open to contract and full-time engineering roles.
      You get the same process as our own apps, from the first prototype to a published, documented release.
    </p>
  </section>

  <section class="wrap body">
    <div class="body__form">
      <EnquiryForm />
    </div>

    <div class="body__side">
      <div>
        <h2 class="display side__title">What you can check first</h2>
        <div class="rows">
          {
            PROOF.map((item) => (
              <a class="proof" href={appUrl(item.app)}>
                <span class="proof__title">{item.title}</span>
                <span class="proof__body">{item.body}</span>
              </a>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="display side__title">How a project runs</h2>
        <ol class="rows steps" role="list">
          {
            STEPS.map((step, index) => (
              <li>
                <span class="mono steps__n">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <span class="proof__title">{step.title}</span>
                  <span class="proof__body">{step.body}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="wrap section split">
    <h2 class="display split__title" data-reveal>Selected commissions</h2>
    <ul class="rows split__main" role="list">
      {
        COMMISSIONS.map((item) => (
          <li class="commission">
            <span>{item.what}</span>
            <span class="mono muted">{item.where}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section split">
    <h2 class="display split__title" data-reveal>Questions</h2>
    <div class="faq split__main">
      {
        HIRE_FAQ.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(48px, 7vw, 96px);
  }
  .head .lede {
    margin-top: 24px;
    max-width: 700px;
  }

  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 40px clamp(32px, 5vw, 80px);
    align-items: flex-start;
    padding-top: clamp(40px, 5vw, 64px);
  }
  .body__form {
    flex: 1.3 1 520px;
    min-width: 0;
  }
  .body__side {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 56px);
  }
  .side__title {
    margin-bottom: 14px;
    font-size: 30px;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .proof {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 16px 0;
    transition: color 0.2s;
  }
  a.proof:hover {
    color: var(--accent);
  }
  .proof__title {
    display: block;
    font-weight: 600;
    font-size: 17px;
  }
  .proof__body {
    display: block;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }

  .steps {
    margin: 0;
    padding: 0;
  }
  .steps li {
    display: flex;
    gap: 16px;
    padding: 16px 0;
  }
  .steps li > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .steps__n {
    flex: 0 0 24px;
    padding-top: 5px;
    color: var(--accent);
  }

  .split {
    display: flex;
    flex-wrap: wrap;
    gap: 28px clamp(40px, 6vw, 96px);
  }
  .split__title {
    flex: 1 1 260px;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 0.95;
  }
  .split__main {
    flex: 2 1 520px;
    min-width: 0;
    margin: 0;
    padding: 0;
    align-self: flex-start;
  }
  .commission {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    align-items: baseline;
    justify-content: space-between;
    padding: 20px 0;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.35;
  }
  .commission > span:first-child {
    flex: 1 1 380px;
  }
</style>

---
import AppCard from '../components/AppCard.astro';
import FeaturedApp from '../components/FeaturedApp.astro';
import HeroPrompt from '../components/HeroPrompt.astro';
import PostRow from '../components/PostRow.astro';
import { SERVICES } from '../data/studio';
import BaseLayout from '../layouts/BaseLayout.astro';
import { appUrl, getApps, getPosts, withBase } from '../lib/content';
import { organization, website } from '../lib/schema';

const apps = await getApps();
const posts = (await getPosts()).slice(0, 3);
const featured = apps.find((app) => app.data.featured) ?? apps[0];
const others = apps.filter((app) => app.id !== featured.id);
const languages = featured.data.specs.find((spec) => spec.k === 'Languages')?.v ?? '17';
---

<BaseLayout jsonLd={[organization(), website()]}>
  <section class="hero" data-hero>
    <canvas class="hero__paper" data-paper aria-hidden="true"></canvas>
    <canvas class="hero__paper" data-sphere aria-hidden="true"></canvas>
    <div class="wrap hero__in">
      <HeroPrompt />

      <div class="hero__row" data-paper-avoid data-sphere-floor>
        <h1 class="display hero__title">Indie software publisher, problem solver.</h1>
        <div class="hero__side">
          <p class="hero__lede">“The problem is not the problem. The problem is your attitude about the problem.”</p>
          <div class="hero__btns">
            <a class="btn btn--solid" href={withBase('/apps/')}>See the apps</a>
            <a class="btn btn--ghost" href={withBase('/work-with-us/')}>Start a project</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap proof" aria-label="At a glance">
    <ul class="proof__list" role="list">
      <li data-reveal style="--i:0">
        <span class="display proof__n">{languages}</span>
        <span class="proof__t">
          languages <a href={appUrl(featured.id)}>{featured.data.name}</a> launched in, on the Microsoft Store
        </span>
      </li>
      <li data-reveal style="--i:1">
        <span class="display proof__n">{apps.length}</span>
        <span class="proof__t">apps published so far, each built to do one specific job</span>
      </li>
      <li data-reveal style="--i:2">
        <span class="display proof__n">3</span>
        <span class="proof__t">platforms they run on: Windows, Chrome and the web</span>
      </li>
    </ul>
  </section>

  <section class="wrap section" id="apps">
    <div class="section-head">
      <h2 class="display h-section" data-reveal>The apps</h2>
      <a class="link" href={withBase('/apps/')}>All apps</a>
    </div>

    <FeaturedApp app={featured} />

    <div class="app-grid">
      {others.map((app, index) => <AppCard app={app} index={index % 3} />)}

      <a class="yours" href={withBase('/work-with-us/')} data-reveal style={`--i:${others.length % 3}`}>
        <span class="yours__plus" aria-hidden="true">+</span>
        <span class="mono yours__label">Client work</span>
        <span class="yours__name">Your project</span>
        <span class="yours__text">
          The next app on this page could be yours. We take on a small number of client projects each year.
        </span>
        <span class="yours__go">Start a project <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="wrap section work">
    <div class="work__intro">
      <h2 class="display h-section" data-reveal>Work with us</h2>
      <p class="work__text" data-reveal style="--i:1">
        Client projects get the same process as our own apps: a working prototype early, then the release work most
        projects leave until last.
      </p>
      <a class="btn btn--solid" href={withBase('/work-with-us/')} data-reveal style="--i:2">Start a project</a>
    </div>

    <div class="rows work__list">
      {
        SERVICES.map((service) => (
          <a class="service" href={withBase(`/work-with-us/?type=${encodeURIComponent(service.type)}`)}>
            <span class="chev" aria-hidden="true">
              ›
            </span>
            <span class="service__main">
              <span class="h-sub">{service.label}</span>
              <span class="service__desc">{service.desc}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="band recent">
    <div class="wrap">
      <h2 class="display h-section" data-reveal>Recently</h2>
      <div class="rows recent__list">
        {
          apps.map((app) => (
            <a class="recent__row" href={appUrl(app.id)}>
              <span class="recent__app">{app.data.name}</span>
              <span class="recent__msg">{app.data.log}</span>
              <span class="recent__status">{app.data.status}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2 class="display h-section" data-reveal>Blog</h2>
      <a class="link" href={withBase('/blog/')}>All posts</a>
    </div>
    <div class="rows">
      {posts.map((post) => <PostRow post={post} />)}
    </div>
  </section>
</BaseLayout>

<script>
  import { startPaper } from '../scripts/paper';
  import { startSphere } from '../scripts/sphere';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-paper]');
  if (canvas) startPaper(canvas);

  const sphere = document.querySelector<HTMLCanvasElement>('[data-sphere]');
  if (sphere) startSphere(sphere);
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: clamp(36px, 5.5vw, 80px) 0 clamp(44px, 5vw, 72px);
  }
  .hero__paper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-mask-image: linear-gradient(#000 72%, transparent);
    mask-image: linear-gradient(#000 72%, transparent);
  }
  /* On phones the sphere would sit right on top of the mark, with no room
     beside it, so it is desktop-only. The faint glyph paper stays. */
  @media (max-width: 820px) {
    canvas[data-sphere] {
      display: none;
    }
  }
  .hero__in {
    position: relative;
  }
  .hero__row {
    display: flex;
    flex-wrap: wrap;
    gap: 28px clamp(32px, 6vw, 96px);
    align-items: flex-end;
    justify-content: space-between;
    margin-top: clamp(36px, 4.6vw, 64px);
    transition: opacity 0.25s;
  }
  .hero[data-typing] .hero__row {
    opacity: 0.1;
  }
  .hero__title {
    flex: 1 1 520px;
    min-width: 0;
    max-width: 780px;
    font-size: clamp(32px, 4.1vw, 60px);
    letter-spacing: -0.04em;
    line-height: 1.02;
    animation: rise 0.7s var(--ease) 0.5s both;
  }
  .hero__side {
    flex: 0 1 430px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    animation: rise 0.7s var(--ease) 0.62s both;
  }
  .hero__lede {
    font-size: 17.5px;
    line-height: 1.55;
    color: var(--body);
    text-wrap: pretty;
  }
  .hero__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ── Proof strip ── */
  .proof__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }
  .proof__list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px 20px 0;
  }
  .proof__list li + li {
    padding-left: 24px;
    border-left: 1px solid var(--rule);
  }
  .proof__n {
    font-size: clamp(40px, 4.6vw, 64px);
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .proof__t {
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
    max-width: 22em;
  }
  .proof__t a {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    transition: color 0.2s;
  }
  .proof__t a:hover {
    color: var(--accent);
  }

  /* ── Apps ── */
  .app-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 12px;
  }

  .yours {
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: clamp(20px, 2vw, 26px);
    border: 1px dashed var(--ink);
    border-radius: var(--r-lg);
    transition:
      background-color 0.25s,
      color 0.25s,
      opacity 0.7s var(--ease),
      transform 0.7s var(--ease);
  }
  .yours:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .yours__plus {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 28px;
    border: 1px dashed currentColor;
    border-radius: 24%;
    font-family: var(--font-mono);
    font-size: 18px;
  }
  .yours__label {
    margin-bottom: 10px;
    opacity: 0.7;
  }
  .yours__name {
    font-family: var(--font-display);
    font-stretch: 118%;
    font-weight: 800;
    font-size: clamp(26px, 2.5vw, 34px);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .yours__text {
    margin-top: 10px;
    margin-bottom: 24px;
    font-size: 16.5px;
    line-height: 1.45;
    opacity: 0.85;
    text-wrap: pretty;
  }
  .yours__go {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px dashed currentColor;
    font-size: 14.5px;
    font-weight: 600;
  }

  /* ── Work with us ── */
  .work {
    display: flex;
    flex-wrap: wrap;
    gap: 32px clamp(40px, 6vw, 96px);
  }
  .work__intro {
    flex: 1 1 320px;
    min-width: 0;
    align-self: flex-start;
    position: sticky;
    top: calc(var(--header-h) + 36px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .work__text {
    max-width: 420px;
    color: var(--body);
    text-wrap: pretty;
  }
  .work__list {
    flex: 1.6 1 520px;
    min-width: 0;
  }
  .service {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding: 22px 0;
    transition:
      color 0.2s,
      padding-left 0.3s var(--ease);
  }
  .service:hover {
    color: var(--accent);
    padding-left: 10px;
  }
  .service__main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .service__desc {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
    max-width: 620px;
  }

  /* ── Recently ── */
  .recent {
    margin-top: var(--section);
    padding: clamp(64px, 8vw, 110px) 0;
  }
  .recent__list {
    margin-top: 28px;
  }
  .recent__row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    align-items: baseline;
    padding: 18px 0;
    transition: color 0.2s;
  }
  .recent__row:hover {
    color: var(--glow);
  }
  .recent__app {
    flex: 0 0 160px;
    font-weight: 600;
    font-size: 15.5px;
  }
  .recent__msg {
    flex: 1 1 360px;
    min-width: 0;
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.35;
  }
  .recent__status {
    font-size: 14px;
    color: var(--faint);
  }

  @media (max-width: 980px) {
    .app-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .work__intro {
      position: static;
    }
  }
  @media (max-width: 760px) {
    .proof__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .proof__list li + li {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 620px) {
    .app-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .recent__app {
      flex-basis: 100%;
    }
  }
</style>

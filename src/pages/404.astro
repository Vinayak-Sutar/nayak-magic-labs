---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/base';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex footerCta={false}>
  <section class="wrap nf">
    <p class="nf__prompt" aria-hidden="true">
      <span class="nf__chev">›</span>404<span class="cursor"></span>
    </p>
    <h1 class="display h-section">That page isn’t here.</h1>
    <p class="lede">
      The address may have changed, or it never existed. Press <kbd>/</kbd> to search the site, or start from one of
      these.
    </p>
    <div class="nf__links">
      <a class="btn btn--solid" href={withBase('/')}>Home</a>
      <a class="btn btn--ghost" href={withBase('/apps/')}>Apps</a>
      <a class="btn btn--ghost" href={withBase('/blog/')}>Blog</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-top: clamp(48px, 8vw, 110px);
  }
  .nf__prompt {
    margin-bottom: clamp(24px, 3vw, 40px);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: clamp(72px, 18vw, 240px);
    line-height: 0.86;
  }
  .nf__chev {
    margin-left: -0.219em;
    margin-right: 0.1em;
    color: var(--accent);
  }
  .nf .lede {
    margin-top: 20px;
  }
  .nf kbd {
    font-family: var(--font-mono);
    font-size: 0.8em;
    background: var(--panel);
    border-radius: 4px;
    padding: 2px 7px;
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
</style>
